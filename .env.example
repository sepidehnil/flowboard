# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/FlowBoard?schema=public"

# Auth.js secret  -  generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public app URL (set this on Vercel production, e.g. https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"

# Trust proxy headers on Vercel (optional; trustHost is also enabled in code)
AUTH_TRUST_HOST="true"
